{
  "tasks": {
    "dev": "deno run --watch --env-file --allow-env --allow-net src/main.ts",
    "start": "deno run --env-file --allow-env --allow-net src/main.ts",

    "prepare": "git config core.hooksPath .githooks",
    "check": "deno check src/main.ts",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",

    "test": "deno test --env-file --allow-env --allow-net",
    "test:watch": "deno test --watch --env-file --allow-env --allow-net",
    "test:coverage": "deno test --coverage=coverage && deno coverage coverage",

    "audit": "deno task check && deno task lint && deno task fmt:check && deno task test"
  },

  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "bcryptjs": "npm:bcryptjs@^3.0.3",
    "hono": "npm:hono@^4.13.9",
    "mongoose": "npm:mongoose@^9.10.2"
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve",
    "include": ["src/", "tests/"],
    "exclude": ["coverage/", "dist/", "*.min.js"]
  },

  "lint": {
    "include": ["src/", "tests/"],
    "exclude": ["coverage/", "dist/"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "no-await-in-loop",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-sparse-arrays",
        "prefer-ascii"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },

  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  }
}