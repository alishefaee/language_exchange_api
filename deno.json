{
"tasks": {
    "dev": "deno run --watch --env-file=.env.local --allow-env --allow-net --allow-read --allow-write --allow-sys src/main.ts",
    "start": "deno run --env-file=.env --allow-env --allow-net --allow-read --allow-write --allow-sys src/main.ts",

    "prepare": "git config core.hooksPath .githooks",
    "check": "deno check src/main.ts",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",

    "test:local": "deno test --env-file=.env.local --allow-env --allow-net --allow-read --allow-write --allow-sys",
    "test:watch": "deno test --watch --env-file=.env.local --allow-env --allow-net --allow-read --allow-write --allow-sys",
    "test:coverage": "deno test --coverage=coverage --env-file=.env.local --allow-env --allow-net --allow-read --allow-write --allow-sys && deno coverage coverage",

    "test:prod": "deno test --env-file=.env --allow-env --allow-net --allow-read --allow-write --allow-sys",

    "audit": "deno task check && deno task lint && deno task fmt:check && deno task test:local"
  },

  "imports": {
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.1",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.9.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/log": "jsr:@std/log@^0.224.14",
    "bcryptjs": "npm:bcryptjs@^3.0.3",
    "hono": "npm:hono@^4.13.9",
    "mongoose": "npm:mongoose@^9.10.2",
    "zod": "npm:zod@^4.6.5"
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve",
    "include": ["src/", "tests/"],
    "exclude": ["coverage/", "dist/", "*.min.js"]
  },

  "lint": {
    "include": ["src/", "tests/"],
    "exclude": ["coverage/", "dist/"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "no-await-in-loop",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-sparse-arrays",
        "prefer-ascii"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },

  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  }
}